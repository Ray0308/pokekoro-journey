{
  "name": "pokekoro-journey",
  "version": "0.9.2-26",
  "private": true,
  "description": "ポケコロジャーニーの整形・検証用ツール",
  "scripts": {
    "format": "prettier --write \"*.{js,css,html}\" \"scripts/**/*.cjs\" \"tools/**/*.cjs\" \"tests/**/*.{js,cjs}\" manifest.webmanifest .prettierrc.json package.json",
    "format:check": "prettier --check \"*.{js,css,html}\" \"scripts/**/*.cjs\" \"tools/**/*.cjs\" \"tests/**/*.{js,cjs}\" manifest.webmanifest .prettierrc.json package.json",
    "check:syntax": "node tools/check-syntax.cjs",
    "data:generate": "node scripts/import-pokemon-data.cjs",
    "data:check": "node scripts/import-pokemon-data.cjs --check",
    "test": "npm run data:check && npm run types:check && node tests/type-effectiveness.cjs && npm run trainers:check && node tests/trainers.cjs && node tests/pokemon-data.cjs && node tests/type-balls.cjs && node tests/pokemon-art.cjs && node tests/retro-music.cjs",
    "music:generate": "node scripts/compose-map-themes.cjs",
    "trainers:generate": "node scripts/build-trainer-data.cjs",
    "trainers:check": "node scripts/build-trainer-data.cjs --check",
    "types:generate": "node scripts/build-type-chart.cjs",
    "types:check": "node scripts/build-type-chart.cjs --check"
  },
  "devDependencies": {
    "acorn": "8.15.0",
    "prettier": "3.6.2"
  }
}
